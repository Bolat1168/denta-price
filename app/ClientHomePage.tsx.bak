'use client';
import React, { useState, useMemo, useEffect } from 'react';
import { Doctor } from '../data/types';
import { services } from '../data/services';
import DesktopHeader from './components/DesktopHeader';
import MobileHeader from './components/MobileHeader';
import LeftSidebarDesktop from './components/LeftSidebarDesktop';
import RightSidebarDesktop from './components/RightSidebarDesktop';
import MobileServicesPanel from './components/MobileServicesPanel';
import { loadAlmatyPrices } from '../pricing/loaders';
import type { AlmatyServicePrice } from '../pricing/types';
import Footer from './components/Footer';

function parsePaymentDate(dateStr?: string): number {
  if (!dateStr) return 0;
  try {
    const [datePart, timePart] = dateStr.split(', ');
    const [day, month, year] = datePart.split('/').map(Number);
    const [hour, minute] = timePart.split(':').map(Number);
    return new Date(2000 + year, month - 1, day, hour, minute).getTime();
  } catch { return 0; }
}

// Р¤СѓРЅРєС†РёСЏ РґР»СЏ РѕС‚РїСЂР°РІРєРё РїСЂРѕСЃРјРѕС‚СЂР°
async function recordView(doctor: Doctor, source: 'view' | 'whatsapp') {
  const firstServiceId = doctor.servicesIds?.[0];
  if (!firstServiceId) return;
  
  const radiusMap: Record<string, number | 'city'> = {
    '1 РєРј': 1,
    '3 РєРј': 3,
    '6 РєРј': 6,
    'Р“РѕСЂРѕРґ': 'city'
  };
  
  try {
    await fetch('/api/stats/record-view', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        dentistId: doctor.id,
        serviceId: firstServiceId,
        radiusKm: radiusMap[doctor.radius] || 'city',
        segment: doctor.segment,
        source: source
      })
    });
  } catch (e) {
    console.error('Failed to record view:', e);
  }
}

export default function ClientHomePage() {
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const [selectedService, setSelectedService] = useState<string>('all');
  const [selectedSegment, setSelectedSegment] = useState<string>('all');
  const [nearbyOnly, setNearbyOnly] = useState<boolean>(false);
  const [almatyPrices, setAlmatyPrices] = useState<AlmatyServicePrice[]>([]);

  const [doctors, setDoctors] = useState<Doctor[]>([]);
  const [loading, setLoading] = useState(true);
  
  // РњРЅРѕР¶РµСЃС‚РІРѕ РґР»СЏ РѕС‚СЃР»РµР¶РёРІР°РЅРёСЏ СѓР¶Рµ Р·Р°С„РёРєСЃРёСЂРѕРІР°РЅРЅС‹С… РїСЂРѕСЃРјРѕС‚СЂРѕРІ (С‡С‚РѕР±С‹ РЅРµ РґСѓР±Р»РёСЂРѕРІР°С‚СЊ)
  const [recordedViews, setRecordedViews] = useState<Set<string>>(new Set());

  const getServiceName = (serviceId: string): string => {
    const service = services.find(s => s.id === serviceId);
    return service?.nameKZ || service?.nameRU || '';
  };

  useEffect(() => {
    loadAlmatyPrices().then(setAlmatyPrices);
  }, []);

  useEffect(() => {
    fetch('/api/dentists/public')
      .then(res => res.json())
      .then(data => {
        setDoctors(data.dentists || []);
        setLoading(false);
      })
      .catch(err => {
        console.error('Failed to load doctors:', err);
        setLoading(false);
      });
  }, []);

  const getDoctorForSlot = (radius: string) => {
    if (nearbyOnly && radius === 'Р“РѕСЂРѕРґ') return null;
    const baseFilter = (d: Doctor) =>
      (selectedService === 'all' || d.servicesIds.includes(selectedService)) &&
      (selectedSegment === 'all' || d.segment === selectedSegment);
    const paid = doctors
      .filter(d => d.isPaid && d.radius === radius && baseFilter(d))
      .sort((a, b) => parsePaymentDate(b.paymentDate) - parsePaymentDate(a.paymentDate));
    if (paid.length > 0) return paid[0];
    const free = doctors.filter(d => !d.isPaid && d.radius === radius && baseFilter(d));
    return free.length > 0 ? free[Math.floor(Math.random() * free.length)] : null;
  };

  const desktopRadii = useMemo(() => {
    if (nearbyOnly) {
      return ['6 РєРј', '6 РєРј', '3 РєРј', '3 РєРј', '1 РєРј', '1 РєРј'];
    }
    return ['6 РєРј', '6 РєРј', '3 РєРј', '3 РєРј', '1 РєРј', 'Р“РѕСЂРѕРґ'];
  }, [nearbyOnly]);

  const desktopSlots = useMemo(
    () => desktopRadii.map(r => getDoctorForSlot(r)),
    [desktopRadii, selectedService, selectedSegment, nearbyOnly, doctors]
  );

  // РњРѕР±РёР»СЊРЅС‹Рµ СЃР»РѕС‚С‹
  const mobileSlots = useMemo((): (Doctor | null)[] => {
    const baseFilter = (d: Doctor) =>
      (selectedService === 'all' || d.servicesIds.includes(selectedService)) &&
      (selectedSegment === 'all' || d.segment === selectedSegment);

    if (nearbyOnly) {
      const radiusOrder = ['6 РєРј', '3 РєРј', '1 РєРј'];
      return radiusOrder.map(radius => {
        const filtered = doctors.filter(d => d.isPaid && d.radius === radius && baseFilter(d));
        filtered.sort((a, b) => parsePaymentDate(b.paymentDate) - parsePaymentDate(a.paymentDate));
        return filtered[0] || null;
      });
    } else {
      const cityDoctors = doctors.filter(d => d.isPaid && d.radius === 'Р“РѕСЂРѕРґ' && baseFilter(d));
      cityDoctors.sort((a, b) => parsePaymentDate(b.paymentDate) - parsePaymentDate(a.paymentDate));
      const result: (Doctor | null)[] = [...cityDoctors.slice(0, 3)];
      while (result.length < 3) result.push(null);
      return result;
    }
  }, [doctors, selectedService, selectedSegment, nearbyOnly]);

  const getSegmentColor = (segment: string) => {
    const colorMap: Record<string, { bg: string; text: string }> = {
      econom: { bg: '#9ca3af', text: '#ffffff' },
      comfort: { bg: '#fbbf24', text: '#000000' },
      optimum: { bg: '#10b981', text: '#ffffff' },
      premium: { bg: '#0ea5e9', text: '#ffffff' },
      luxury: { bg: '#8b5cf6', text: '#ffffff' },
    };
    return colorMap[segment] || { bg: '#f3f4f6', text: '#9ca3af' };
  };

  // РћР±СЂР°Р±РѕС‚С‡РёРє РєР»РёРєР° РїРѕ WhatsApp СЃ Р·Р°РїРёСЃСЊСЋ
  const handleWhatsAppClick = (doctor: Doctor) => {
    recordView(doctor, 'whatsapp');
    window.open(`https://wa.me/${doctor.phone.replace(/\D/g, '')}`, '_blank');
  };

  // РљРѕРјРїРѕРЅРµРЅС‚ РєР°СЂС‚РѕС‡РєРё СЃ Р·Р°РїРёСЃСЊСЋ РїСЂРѕСЃРјРѕС‚СЂР°
  const DoctorCard = ({ doctor, onView }: { doctor: Doctor; onView?: () => void }) => {
    const viewKey = `view_${doctor.id}`;
    const [hasRecorded, setHasRecorded] = useState(false);
    
    useEffect(() => {
      if (!hasRecorded && doctor.servicesIds?.[0]) {
        recordView(doctor, 'view');
        setHasRecorded(true);
        if (onView) onView();
      }
    }, [doctor.id]);
    
    const serviceName = getServiceName(doctor.servicesIds?.[0]);
    const formattedPrice = doctor.price > 0 ? doctor.price.toLocaleString('ru-RU') : '0';
    
    return (
      <div className="border border-gray-200 bg-white p-3">
        <div className="flex gap-3">
          <div className="w-[35%] aspect-square overflow-hidden bg-gray-100">
            <img src={doctor.photoUrl} alt={doctor.name} className="w-full h-full object-cover" />
          </div>
          <div className="w-[65%] flex flex-col justify-between">
            <div>
              <h3 className="text-sm font-black uppercase leading-tight">{doctor.name}</h3>
              <div className="text-xs text-gray-600 mt-1 line-clamp-2">{serviceName}</div>
              <div className="text-xs font-black mt-1">
                {formattedPrice !== '0' ? `${formattedPrice} в‚ё` : 'РўР•РќР“Р• / РћРў'}
              </div>
            </div>
          </div>
        </div>
        <button
          onClick={() => handleWhatsAppClick(doctor)}
          className="w-full bg-green-600 text-white py-2 text-xs font-black uppercase tracking-widest hover:bg-green-700 mt-3"
        >
          Р—РђРџРРЎРђРўР¬РЎРЇ
        </button>
      </div>
    );
  };

  return (
    <div className="w-full h-screen flex flex-col overflow-hidden bg-white font-sans">
      <DesktopHeader />
      <MobileHeader isMobileMenuOpen={isMobileMenuOpen} setIsMobileMenuOpen={setIsMobileMenuOpen} />
      <MobileServicesPanel
        isMobileMenuOpen={isMobileMenuOpen}
        selectedService={selectedService}
        setSelectedService={setSelectedService}
        onClose={() => setIsMobileMenuOpen(false)}
        setNearbyOnly={setNearbyOnly}
      />

      <main className="flex-grow w-full overflow-hidden">
        {/* Р”РµСЃРєС‚РѕРїРЅР°СЏ СЃРµС‚РєР° */}
        <div className="hidden lg:grid grid-cols-[22vw_58vw_20vw] h-full overflow-hidden border-x border-gray-200">
          <aside className="h-full overflow-y-auto border-r border-gray-200">
            <LeftSidebarDesktop
              selectedService={selectedService}
              setSelectedService={setSelectedService}
            />
          </aside>

          <section className="h-full flex flex-col p-4 bg-white">
            <div className="flex-1 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 grid-rows-2 gap-2 min-h-0">
              {desktopSlots.map((doctor, idx) => (
                <div key={idx} className="border border-gray-200 p-2 flex flex-col bg-white h-full min-h-0">
                  {doctor ? (
                    <>
                      <div className="w-3/4 mx-auto aspect-square mb-1 overflow-hidden">
                        <img src={doctor.photoUrl} alt={doctor.name} className="w-full h-full object-cover object-top border border-gray-200" />
                      </div>
                      <div className="ml-[12.5%]">
                        <h3 className="text-xs font-black uppercase leading-tight text-black text-left">{doctor.name}</h3>
                        <div className="text-xs font-black uppercase text-black mb-0.5 text-left">
                          {doctor.price > 0 ? `${doctor.price.toLocaleString('ru-RU')} в‚ё` : 'РўР•РќР“Р• / РћРў'}
                        </div>
                      </div>
                      <button 
                        onClick={() => handleWhatsAppClick(doctor)}
                        className="w-full bg-green-600 text-white py-1 rounded-none font-black text-xs uppercase tracking-widest hover:bg-green-700 mt-auto"
                      >
                        Р—РђРџРРЎРђРўР¬РЎРЇ
                      </button>
                    </>
                  ) : (
                    <div className="flex flex-col h-full min-h-0">
                      <div className="w-3/4 mx-auto aspect-square mb-1 bg-gray-100"></div>
                      <div className="ml-[12.5%]">
                        <h3 className="text-xs font-black uppercase leading-tight text-gray-400 text-left">Р¤РђРњРР›РРЇ Р.Рћ</h3>
                        <div className="text-xs font-black uppercase text-gray-400 mb-0.5 text-left">РўР•РќР“Р• / РћРў</div>
                      </div>
                      <button className="w-full bg-green-600 text-white py-1 mt-auto cursor-not-allowed opacity-50" disabled>Р—РђРџРРЎРђРўР¬РЎРЇ</button>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>

          <aside className="h-full overflow-y-auto border-l border-gray-200">
            <RightSidebarDesktop
              selectedSegment={selectedSegment}
              setSelectedSegment={setSelectedSegment}
              nearbyOnly={nearbyOnly}
              setNearbyOnly={setNearbyOnly}
              almatyPrices={almatyPrices}
              selectedService={selectedService}
            />
          </aside>
        </div>

        {/* РњРћР‘РР›Р¬РќРђРЇ РЎР•РўРљРђ */}
        <div className="lg:hidden h-full overflow-y-auto pb-4">
          <div className="px-3 py-2">
            {/* РЎРµРіРјРµРЅС‚С‹ */}
            <div className="grid grid-cols-5 gap-1 mb-3">
              {['luxury', 'premium', 'optimum', 'comfort', 'econom'].map((seg) => {
                const colors: Record<string, string> = {
                  luxury: 'bg-purple-600',
                  premium: 'bg-blue-500',
                  optimum: 'bg-green-500',
                  comfort: 'bg-yellow-400',
                  econom: 'bg-gray-400',
                };
                const isActive = selectedSegment === seg;
                return (
                  <button
                    key={seg}
                    onClick={() => setSelectedSegment(selectedSegment === seg ? 'all' : seg)}
                    className={`${colors[seg]} text-white text-[10px] font-black uppercase py-2 rounded ${
                      isActive ? 'ring-2 ring-black ring-offset-1' : ''
                    }`}
                  >
                    {seg}
                  </button>
                );
              })}
            </div>

            {/* РљРЅРѕРїРєРё City / Р СЏРґРѕРј */}
            <div className="flex gap-2 mb-3">
              <button
                onClick={() => setNearbyOnly(false)}
                className={`flex-1 py-2 text-sm font-medium rounded-lg transition-colors ${
                  !nearbyOnly
                    ? 'bg-gray-800 text-white'
                    : 'bg-gray-200 text-gray-800 hover:bg-gray-300'
                }`}
              >
                City
              </button>
              <button
                onClick={() => setNearbyOnly(true)}
                className={`flex-1 py-2 text-sm font-medium rounded-lg transition-colors ${
                  nearbyOnly
                    ? 'bg-gray-800 text-white'
                    : 'bg-gray-200 text-gray-800 hover:bg-gray-300'
                }`}
              >
                Р СЏРґРѕРј
              </button>
            </div>

            {/* РќР°РґРїРёСЃСЊ */}
            <div className="flex items-center justify-center gap-2 mb-3">
              <span className="text-[#00BFFF] text-base font-black uppercase tracking-tighter">
                Р”РµРЅСЃР°СѓР»С‹Т“С‹ТЈС‹Р·РґС‹ С‚Р°ТЈРґР°ТЈС‹Р·
              </span>
              <span className="text-gray-400 text-xs font-medium italic">
                / Р’С‹Р±РµСЂРё СЃРІРѕРµРіРѕ РґР°РЅС‚РёСЃС‚Р°
              </span>
            </div>

            {/* РљР°СЂС‚РѕС‡РєРё */}
            <div className="flex flex-col gap-3">
              {mobileSlots.map((doctor, index) => {
                if (doctor) {
                  return <DoctorCard key={doctor.id} doctor={doctor} />;
                } else {
                  return (
                    <div key={`empty-${index}`} className="border border-gray-200 bg-white p-3">
                      <div className="flex gap-3">
                        <div className="w-[35%] aspect-square bg-gray-100"></div>
                        <div className="w-[65%]">
                          <h3 className="text-sm font-black uppercase text-gray-400">Р¤РђРњРР›РРЇ Р.Рћ</h3>
                          <div className="text-xs text-gray-400 mt-1">РЈРЎР›РЈР“Рђ</div>
                          <div className="text-xs font-black mt-1 text-gray-400">РўР•РќР“Р• / РћРў</div>
                        </div>
                      </div>
                      <button className="w-full bg-green-600 text-white py-2 mt-3 cursor-not-allowed opacity-50" disabled>Р—РђРџРРЎРђРўР¬РЎРЇ</button>
                    </div>
                  );
                }
              })}
            </div>
          </div>
        </div>
      </main>
      <Footer />
    </div>
  );
}